{
  "name": "fixer-marketplace-backend",
  "version": "1.0.0",
  "description": "Backend API RESTful para la plataforma Fixer Trades Marketplace construida con Node.js, Express, TypeScript, Sequelize y PostgreSQL bajo Clean Code, SOLID y POO.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsx --test src/__tests__/**/*.ts"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "express",
    "postgresql",
    "sequelize",
    "oop",
    "clean-code",
    "solid",
    "fixer"
  ],
  "author": "Fixer Development Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "lint-staged": "^17.6.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "lint-staged": {
    "*.{ts,js,json,md,yml,yaml}": "git diff --check --cached --"
  }
}
